<!DOCTYPE html>
<html>

<head>
  <meta charset="utf-8">
  <title>Add New Book</title>
  <link rel="stylesheet" href="/styles.css">
</head>

<body class="add-book-page">
  <%- include('partials/navbar', { active: 'books' }) %>

    <div class="container form-container">
      <h1>Add New Book</h1>

      <% if (errors && errors.length) { %>
        <ul class="error-list">
          <% errors.forEach(err=> { %>
            <li>
              <%= err.msg %>
            </li>
            <% }) %>
        </ul>
        <% } %>

          <form action="/books/new" method="post" novalidate>
            <div class="form-group">
              <label for="title">Title</label>
              <input id="title" name="title" type="text" value="<%= old.title || '' %>" required maxlength="200"
                placeholder="Enter book title">
            </div>

            <!-- type -->
            <div class="form-group">
              <label for="author">Author Name</label>
              <input id="author" name="author" type="text" value="<%= old.author || '' %>" required maxlength="100" placeholder="Enter author name">
            </div>

            <div class="form-group">
              <!-- here is adding step so the availability must be more then 0 -->
              <label for="availability">Availability</label>
              <input id="availability" name="availability" type="number" min="1"
                value="<%= old.availability != null ? old.availability : '' %>" required>
            </div>

            <button type="submit" class="btn">Create Book</button>
          </form>

          <p class="back-link"><a href="/">← Back to Book List</a></p>
    </div>
</body>

</html>