<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="utf-8">
  <title>Borrow Books</title>
  <link rel="stylesheet" href="/styles.css">
</head>

<body>
  <% var active='borrowed' ; %>
    <%- include('partials/navbar', { active: active }) %>

      <div class="container">
        <h2>Currently Borrowed Books</h2>

        <!-- Success message prompt-->
        <div id="returnMessage" class="success-message" style="display:none;"></div>

        <table class="book-table">
          <thead>
            <tr>
              <th>Record ID</th>
              <th>User</th>
              <th>Book Title</th>
              <th>Borrow Date</th>
              <th>Action</th>
            </tr>
          </thead>
          <tbody>
            <% if (records.length===0) { %>
              <tr>
                <td colspan="5" class="no-data">No borrowed books.</td>
              </tr>
              <% } else { %>
                <% records.forEach(r=> { %>
                  <tr data-record="<%= r.recordId %>">
                    <td>
                      <%= r.recordId %>
                    </td>
                    <td>
                      <%= r.userName %>
                    </td>
                    <td>
                      <%= r.bookTitle %>
                    </td>
                    <td>
                      <%= r.borrow_date %>
                    </td>
                    <td>
                      <button class="btn-return" data-id="<%= r.recordId %>">
                        Return
                      </button>
                    </td>
                  </tr>
                  <% }) %>
                    <% } %>
          </tbody>
        </table>
      </div>

      <script src="/scripts.js"></script>
</body>

</html>