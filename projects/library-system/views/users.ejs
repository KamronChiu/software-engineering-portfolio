<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="utf-8">
  <title>User Management</title>
  <link rel="stylesheet" href="/styles.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
</head>

<body class="users-page">
  <% var active = 'users'; %>
  <%- include('partials/navbar', { active: active }) %>

  <div class="container">

    <!-- Flash Error -->
    <% if (errorMessage) { %>
      <p class="error-message"><%= errorMessage %></p >
    <% } %>

    <!-- Flash Success -->
    <% if (successMessage) { %>
      <p class="success-message"><%= successMessage %></p >
    <% } %>

    <!-- Validation Errors -->
    <% if (errors && errors.length) { %>
      <ul class="error-list">
        <% errors.forEach(err => { %>
          <li><i class="fas fa-exclamation-circle"></i> <%= err.msg %></li>
        <% }) %>
      </ul>
    <% } %>

    <!-- Add User Toolbar -->
    <div class="toolbar">
      <form action="/users/add" method="POST" class="search-bar">
        <i class="fas fa-user-plus"></i>
        <input
          type="text"
          name="name"
          placeholder="Enter user name"
          required
          value="<%= old.name || '' %>"
        >
        <input
          type="date"
          name="dob"
          title="Date of birth (optional)"
          value="<%= old.dob || '' %>"
        >
        <button type="submit">
          <i class="fas fa-plus-circle"></i> Add User
        </button>
      </form>
    </div>

    <!-- Stats -->
    <p class="stats">
      <i class="fas fa-users"></i>
      Users on This Page: <%= users.length %>
    </p >

    <!-- User Table -->
    <table class="book-table user-table">
      <thead>
        <tr>
          <th><i class="fas fa-hashtag"></i> ID</th>
          <th><i class="fas fa-user"></i> Name</th>
          <th><i class="fas fa-birthday-cake"></i> Date of Birth</th>
          <th><i class="fas fa-tools"></i> Actions</th>
        </tr>
      </thead>
      <tbody>
        <% if (users.length === 0) { %>
          <tr>
            <td colspan="4" class="no-data">No users found.</td>
          </tr>
        <% } else { %>
          <% users.forEach(u => { %>
            <tr>
              <td><%= u.id %></td>
              <td><%= u.name %></td>
              <td><%= u.dob || '--' %></td>
              <td class="actions">
                <a href="/users/<%= u.id %>" class="action-link">
                  <i class="fas fa-eye"></i> View
                </a >
                <form
                  action="/users/<%= u.id %>/delete"
                  method="POST"
                  class="inline-form"
                  onsubmit="return confirm('Delete this user?');"
                >
                  <button type="submit" class="action-button">
                    <i class="fas fa-trash-alt"></i> Delete
                  </button>
                </form>
              </td>
            </tr>
          <% }) %>
        <% } %>
      </tbody>
    </table>

    <!-- Pagination -->
    <ul class="pagination">
      <% if (page > 1) { %>
        <li class="prev">
          <a href="/users?page=<%= page - 1 %>">
            <i class="fas fa-chevron-left"></i> Prev
          </a >
        </li>
      <% } %>

      <% for (let p = 1; p <= totalPages; p++) { %>
        <li class="<%= p === page ? 'active' : '' %>">
          <% if (p === page) { %>
            <span><%= p %></span>
          <% } else { %>
            <a href="/users?page=<%= p %>"><%= p %></a >
          <% } %>
        </li>
      <% } %>

      <% if (page < totalPages) { %>
        <li class="next">
          <a href="/users?page=<%= page + 1 %>">
            Next <i class="fas fa-chevron-right"></i>
          </a >
        </li>
      <% } %>
    </ul>

  </div>
</body>

</html>